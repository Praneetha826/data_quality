# Database Configuration (for later milestones)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_quality
DB_USER=your_username
DB_PASSWORD=your_password

# LLM Configuration
LLM_PROVIDER=local
# Options: local, gemini, groq
# local: Uses Hugging Face models (requires HF_TOKEN for gated models)
# gemini: Uses Google Gemini API (requires GEMINI_API_KEY)
# groq: Uses Groq API (requires GROQ_API_KEY)

LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# Options for local provider:
#   - meta-llama/Meta-Llama-3-8B-Instruct (default, requires HF access)
#   - Qwen/Qwen2.5-3B-Instruct (alternative)

# Gemini API Configuration (only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Options: gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro, gemini-pro
# Note: gemini-2.5-flash and gemini-3.8-flash may not be available to new users

# Debug Mode (for development)
DEBUG_MODE=false
# Options: true, false
# When true: detailed debug output is printed to terminal and displayed in Streamlit UI
# When false: clean production UI with no debug messages

# Hugging Face Token (only for local provider and gated models)
HF_TOKEN=your_hugging_face_token_here  # Optional: for gated models
